# ============================================================
# .env.example — audithygiène
# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local est ignoré par git. NE JAMAIS commiter de secrets.
# Détail de chaque clé : voir KIT_DE_CONNEXION.md
# ============================================================

# Convention : chaque variable listée ici est lue par le code. Celles qui ne le
# sont pas encore sont marquées « NON LU PAR LE CODE ». Un .env.example qui
# documente des variables fantomes fait poser les mauvaises clés en prod : c'est
# exactement ce qui a mis le classeur Google hors service.

# --- App ---
# URL publique du site vitrine (metadata, canonical, images des emails).
NEXT_PUBLIC_SITE_URL="https://audithygiene.fr"
# URL de l'app opérationnelle (liens internes).
NEXT_PUBLIC_APP_URL="https://app.audithygiene.fr"

# --- Vérification moteurs de recherche (SEO) ---
# Google Search Console : jeton de la balise "meta tag" (valeur de content uniquement).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools : valeur de la balise msvalidate.01.
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# --- Base de données : Supabase / Postgres (🔴 BLOQUANT) ---
# Connexion applicative (pooler pgbouncer). Absente = leads non persistés.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Connexion directe, utilisée par les migrations Prisma (prisma/schema.prisma).
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
# Projet Supabase, côté navigateur.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
# Clé anonyme Supabase, côté navigateur.
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
# Clé service_role, serveur uniquement (upload des rapports).
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
# Bucket de stockage des PDF. Défaut du code si absent : "rapports".
SUPABASE_STORAGE_BUCKET="rapports"

# --- Auth (généré en interne) ---
# NON LU PAR LE CODE aujourd'hui (l'auth passe par Supabase). Réservé.
AUTH_SECRET="[openssl rand -base64 32]"

# --- Telegram (🟠) ---
# Jeton du bot BotFather. Absent = notifications Telegram ignorées.
TELEGRAM_BOT_TOKEN="[BOTFATHER_TOKEN]"
# Id de la conversation ou du groupe qui reçoit les alertes.
TELEGRAM_CHAT_ID="[CHAT_ID]"

# --- Brevo (🟠) ---
# Clé API v3. Absente = aucun email transactionnel envoyé (confirmation lead,
# alerte interne vers contact@audithygiene.fr, envoi de rapport).
BREVO_API_KEY="[BREVO_API_KEY]"
# Expéditeur des emails. Doit être un sender VÉRIFIÉ dans Brevo, sinon l'envoi
# est refusé côté Brevo alors que la clé est bonne. Défaut du code si absent.
BREVO_SENDER_EMAIL="contact@audithygiene.fr"
# Nom affiché de l'expéditeur. Défaut du code si absent : "audit hygiène".
BREVO_SENDER_NAME="audit hygiène"

# --- Stripe (🟢 — mode test d'abord) ---
# Clé secrète Stripe, serveur uniquement.
STRIPE_SECRET_KEY="sk_test_[...]"
# NON LU PAR LE CODE aujourd'hui (aucun Checkout côté client). Réservé.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_[...]"
# Secret de signature du webhook Stripe.
STRIPE_WEBHOOK_SECRET="whsec_[...]"

# --- Yousign (🟢) ---
# NON LU PAR LE CODE aujourd'hui (e-signature non branchée). Réservé.
YOUSIGN_API_KEY="[YOUSIGN_API_KEY]"
YOUSIGN_API_URL="https://api-sandbox.yousign.app/v3"

# --- Google : compte de service (🟠) ---
# Une seule identité sert au classeur ET au Drive. Deux conventions sont
# acceptées par src/lib/classeur.ts, dans cet ordre de priorité :
#
#   1) GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY
#   2) à défaut, GOOGLE_SERVICE_ACCOUNT_B64
#
# Piège vécu : poser l'EMAIL sans la PRIVATE_KEY ne sert à rien. Le code
# retombe alors sur le B64, c'est-à-dire sur un AUTRE compte de service, et
# Google répond 403 si le classeur n'a pas été partagé avec celui-là. Les deux
# variables du couple 1) vont ensemble ou pas du tout.
#
# Email du compte de service (…@….iam.gserviceaccount.com).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Clé privée PEM du MÊME compte, sur une ligne, \n littéraux acceptés :
#   "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Variante : la clé JSON entière du compte de service, encodée en base64
# (une seule ligne). Utilisée seule, elle suffit pour le classeur et le Drive.
#   base64 -w0 service-account.json   (ou : certutil -encode sous Windows)
GOOGLE_SERVICE_ACCOUNT_B64=""

# --- Google Sheets : classeur de sauvegarde des leads (🟠) ---
# Id du classeur « AUDIT HYGIENE - WORKFLOW » (dans l'URL, entre /d/ et /edit).
# Vide = la sauvegarde tableur est dormante, aucun autre effet.
# ⚠️ Le classeur doit être partagé en Éditeur avec le compte de service
# réellement utilisé (celui que le journal affiche : « [classeur] compte de
# service : … »). Sans ce partage, Google répond 403 PERMISSION_DENIED.
GOOGLE_SHEET_BACKUP_ID=""

# --- Sauvegarde photos sur Google Drive (Shared Drive Workspace) ---
# Dormant tant que GOOGLE_SERVICE_ACCOUNT_B64 et GOOGLE_DRIVE_ID ne sont pas
# remplies (aucun impact sinon).
# Id du Shared Drive (dans l'URL : drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_ID=""
# Option : id d'un dossier DANS le Shared Drive où ranger les audits (sinon racine)
GOOGLE_DRIVE_PARENT_ID=""

# --- Vercel (CI/CD, optionnel en local) ---
# NON LU PAR LE CODE : utilisées par la CLI Vercel / la CI, pas par l'app.
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# --- Cron (généré en interne) ---
# Exposé par src/lib/env.ts (env.cronSecret) mais AUCUNE route ne le vérifie
# encore. Réservé pour la protection des futurs crons Vercel.
CRON_SECRET="[openssl rand -hex 16]"

# --- IA : restitution auditresto360 (clé Anthropic directe) ---
# Clé API Anthropic. Absente = restitution IA indisponible.
ANTHROPIC_API_KEY="sk-ant-[...]"
# Modèle utilisé. Défaut du code si absent : "claude-sonnet-4-6".
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Scripts locaux (hors application) ---
# scripts/test-rapport-send.ts : chemin du PDF à envoyer. Jamais requis en prod.
OUT_PDF=""
